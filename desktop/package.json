{
  "name": "pocket-trader-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "PocketTrader desktop (Electron wrapper around the web export)",
  "author": "lyonkg",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack:mac": "electron-builder --mac zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.demo.pockettrader",
    "productName": "PocketTrader",
    "copyright": "Copyright © 2026",
    "directories": { "output": "out", "buildResources": "build" },
    "files": ["main.js", "preload.js", "www/**/*"],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": null,
      "gatekeeperAssess": false,
      "target": [
        { "target": "zip", "arch": ["x64", "arm64"] }
      ]
    }
  }
}
