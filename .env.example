# Market data provider used at startup: mock (default) or live
EXPO_PUBLIC_DATA_PROVIDER=mock

# Optional backend proxy base URL (recommended for production). When set, the app
# never talks to Finnhub with a client-side key. See proxy/README.md.
# EXPO_PUBLIC_DATA_PROXY_URL=https://your-proxy.example

# Do NOT set API keys here for a production web export (GitHub Pages). They would
# be baked into the public JavaScript bundle. Enter a Finnhub key in the in-app
# Settings screen (stored only on the device), or hold keys on the proxy.
#
# For local development only (never commit the real .env):
# EXPO_PUBLIC_FINNHUB_API_KEY=
# EXPO_PUBLIC_API_KEY=          # deprecated alias of the Finnhub key
# EXPO_PUBLIC_COINGECKO_API_KEY=  # optional CoinGecko demo key
